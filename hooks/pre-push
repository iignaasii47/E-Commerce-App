#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Pre-push hook: SonarQube scan
# Blocks the push if the scan fails.
# =============================================================================

# --- Configuration -----------------------------------------------------------
SONAR_HOST_URL="http://localhost:9000"

# --- Helpers -----------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

info()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
fail()  { echo -e "${RED}[FAIL]${NC}  $*"; }

# --- Skip on main ------------------------------------------------------------
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$BRANCH" = "main" ]; then
  info "On main branch — skipping pre-push hook."
  exit 0
fi

# --- Load .env ---------------------------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel)"
ENV_FILE="$REPO_ROOT/.env"

if [ -f "$ENV_FILE" ]; then
  info "Loading .env from $ENV_FILE"
  set -a
  # shellcheck disable=SC1091
  source "$ENV_FILE"
  set +a
else
  warn ".env file not found at $ENV_FILE — environment variables must be exported."
fi

# --- Validate required env vars ----------------------------------------------
MISSING=0
for VAR in SONAR_TOKEN NVD_API_KEY; do
  if [ -z "${!VAR:-}" ]; then
    fail "Required environment variable $VAR is not set."
    MISSING=1
  fi
done
if [ "$MISSING" -eq 1 ]; then
  fail "Missing required environment variables. Aborting."
  exit 1
fi

# =============================================================================
# SonarQube Scan
# =============================================================================
info "========================================="
info "SonarQube Scan"
info "========================================="

# --- Check SonarQube server --------------------------------------------------
if ! curl -sf "$SONAR_HOST_URL/api/system/status" > /dev/null 2>&1; then
  fail "SonarQube server is not reachable at $SONAR_HOST_URL"
  fail "Push blocked. Start SonarQube and try again."
  exit 1
fi
ok "SonarQube server is reachable."

# --- Backend scan ------------------------------------------------------------
info "Running backend SonarQube scan..."
(
  cd "$REPO_ROOT/backend"
  if [ ! -f "./mvnw" ]; then
    fail "Maven wrapper (mvnw) not found in backend/"
    exit 1
  fi
  chmod +x ./mvnw 2>/dev/null || true
  ./mvnw clean verify sonar:sonar \
    "-Dsonar.host.url=$SONAR_HOST_URL" \
    "-Dsonar.token=$SONAR_TOKEN" \
    "-DnvdApiKey=$NVD_API_KEY"
)
BACKEND_EXIT=$?
if [ "$BACKEND_EXIT" -ne 0 ]; then
  fail "Backend SonarQube scan failed with exit code $BACKEND_EXIT."
  fail "Push blocked."
  exit 1
fi
ok "Backend scan passed."

# --- Frontend scan -----------------------------------------------------------
info "Running frontend tests + SonarQube scan..."
(
  cd "$REPO_ROOT/frontend"
  npm test -- --watch=false --coverage --coverage-reporters lcov --coverage-reporters text
  npx sonar-scanner
)
FRONTEND_EXIT=$?
if [ "$FRONTEND_EXIT" -ne 0 ]; then
  fail "Frontend SonarQube scan failed with exit code $FRONTEND_EXIT."
  fail "Push blocked."
  exit 1
fi
ok "Frontend scan passed."

ok "SonarQube scans completed successfully."

# =============================================================================
# All checks passed
# =============================================================================
echo ""
ok "All checks passed. Push allowed."
exit 0
